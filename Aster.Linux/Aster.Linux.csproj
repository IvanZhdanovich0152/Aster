<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <RootNamespace>Aster.Linux</RootNamespace>
        <AssemblyName>Aster</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Aster.Core/Aster.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" >
            <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" >
            <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.4" />
        <PackageReference Include="Mime-Detective" Version="25.8.1" />
        <PackageReference Include="Mime-Detective.Definitions.Exhaustive" Version="25.8.1" />
        <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
    </ItemGroup>
</Project>
