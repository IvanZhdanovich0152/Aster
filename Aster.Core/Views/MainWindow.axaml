<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aster.Core.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Aster.Core.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Aster.Core">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding CurrentPath, Mode=TwoWay}"
                     PlaceholderText="Path" />
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />
            <Button Grid.Column="2"
                    Content="Up"
                    Command="{Binding GoUpCommand}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,8"
                   Foreground="IndianRed"
                   Text="{Binding ErrorMessage}" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding LastModTime}" />
                        <TextBlock Grid.Column="2" Text="{Binding SizeB}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Entries.Count, StringFormat='Entries: {0}'}" />
            <Button Content="Open directory"
                    Command="{Binding OpenSelectedCommand}" />
        </StackPanel>
    </Grid>

</Window>
