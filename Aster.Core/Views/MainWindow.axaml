<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Aster.Core.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        x:Class="Aster.Core.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/aster.png"
        Title="Aster"
        Width="1280"
        Height="760"
        Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="216,*"
          Background="{DynamicResource AppBackgroundBrush}">
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="14,12,10,10">
                    <TextBlock Text="⌕"
                               FontSize="26"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="☰"
                               FontSize="20"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0"
                                Spacing="2">
                        <Button Classes="nav-button"
                                Content="⌂   Home"
                                Command="{Binding GoHomeCommand}" />
                        <Separator Margin="8,10" />

                        <TextBlock Text="PLACES"
                                   Margin="12,4,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Classes="nav-button"
                                Content="▣   Desktop"
                                Command="{Binding GoDesktopCommand}" />
                        <Button Classes="nav-button"
                                Content="▤   Documents"
                                Command="{Binding GoDocumentsCommand}" />
                        <Button Classes="nav-button"
                                Content="⇩   Downloads"
                                Command="{Binding GoDownloadsCommand}" />
                        <Button Classes="nav-button"
                                Content="▧   Pictures"
                                Command="{Binding GoPicturesCommand}" />
                        <Button Classes="nav-button"
                                Content="♫   Music"
                                Command="{Binding GoMusicCommand}" />
                        <Button Classes="nav-button"
                                Content="▰   Videos"
                                Command="{Binding GoVideosCommand}" />

                        <Separator Margin="8,10" />

                        <TextBlock Text="COMPUTER"
                                   Margin="12,4,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Classes="nav-button"
                                Content="▣   Root"
                                Command="{Binding GoRootCommand}" />
                        <Button Classes="nav-button"
                                Content="◉   Local filesystem"
                                Command="{Binding GoRootCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*,Auto"
              Margin="10,8,10,8">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="10">
                <Button Content="↑"
                        Command="{Binding GoUpCommand}"
                        ToolTip.Tip="Вверх" />
                <Button Grid.Column="1"
                        Content="↻"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Обновить" />
                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="⌂"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CurrentPath, Mode=TwoWay}"
                                 PlaceholderText="Путь к папке..."
                                 Background="Transparent"
                                 BorderThickness="0">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter"
                                            Command="{Binding NavigatePathCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Grid.Column="3"
                        Content="▦"
                        Command="{Binding ToggleViewCommand}"
                        ToolTip.Tip="Переключить вид" />
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,120,150,90"
                  ColumnSpacing="12"
                  Margin="10,12,10,4">
                <TextBlock Grid.Column="1"
                           Text="Name"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" />
                <TextBlock Grid.Column="2"
                           Text="Type"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" />
                <TextBlock Grid.Column="3"
                           Text="Modified"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" />
                <TextBlock Grid.Column="4"
                           Text="Size"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           HorizontalAlignment="Right" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <ListBox IsVisible="{Binding IsListView}"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             Background="Transparent"
                             DoubleTapped="OnEntryDoubleTapped">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть каталог"
                                          Command="{Binding OpenSelectedCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,120,150,90"
                                      ColumnSpacing="12"
                                      Margin="8,4">
                                    <Image Grid.Column="0"
                                           Source="{Binding IconImage}"
                                           Width="22"
                                           Height="22" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Type}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ModifiedDate}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding FormattedSize}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox IsVisible="{Binding IsGridView}"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             Background="Transparent"
                             DoubleTapped="OnEntryDoubleTapped">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Открыть каталог"
                                          Command="{Binding OpenSelectedCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150"
                                        Height="112"
                                        Margin="8"
                                        Padding="10"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Spacing="6">
                                        <Image Source="{Binding IconImage}"
                                               Width="46"
                                               Height="46"
                                               HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Type}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,6">
                <Grid ColumnDefinitions="*,*,Auto">
                    <TextBlock Grid.Column="0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Entries.Count, StringFormat='Элементов: {0}'}" />
                    <TextBlock Grid.Column="1"
                               FontSize="12"
                               Foreground="{DynamicResource ErrorBrush}"
                               Text="{Binding ErrorMessage}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding SelectedEntry.FormattedSize, StringFormat='Выбрано: {0}'}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
