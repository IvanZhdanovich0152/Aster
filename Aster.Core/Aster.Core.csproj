<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>Aster.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4">
            <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4">
            <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4"/>
        
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        
        <PackageReference Include="Mono.Posix.NETStandard" Version="1.0.0" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.4"/>
        <PackageReference Include="SharpCompress" Version="0.50.10" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\Dialogs\PreviewWindow.axaml.cs">
        <DependentUpon>PreviewWindow.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
