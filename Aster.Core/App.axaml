<Application x:Class="Aster.Core.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Aster.Core"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <core:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IconFont">avares://Aster.Core/Assets/FiraCodeNerdFont-Regular.ttf#FiraCode Nerd Font</FontFamily>

            <KeyGesture x:Key="DeleteGesture">Shift+Delete</KeyGesture>
            <KeyGesture x:Key="UndoGesture">Ctrl+Z</KeyGesture>
            <KeyGesture x:Key="RedoGesture">Ctrl+Y</KeyGesture>
            <KeyGesture x:Key="SelectAllGesture">Ctrl+A</KeyGesture>
            <KeyGesture x:Key="SelectNoneGesture">Ctrl+Shift+L</KeyGesture>
            <KeyGesture x:Key="InvertSelectionGesture">Multiply</KeyGesture>
            <KeyGesture x:Key="GoUpGesture">Alt+Up</KeyGesture>
            <KeyGesture x:Key="EmptyGesture">None</KeyGesture>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PrimaryColor">#F4F5F6</Color>
                    <Color x:Key="BackgroundColor">#FFFFFF</Color>
                    <Color x:Key="SecondaryColor">#E2E5E8</Color>
                    <Color x:Key="TextBoxColor">#ECEFF1</Color>
                    <Color x:Key="TextColor">#252A30</Color>
                    <Color x:Key="IconColor">#58616B</Color>
                    <Color x:Key="AccentColor">#52796F</Color>
                    <Color x:Key="SelectionColor">#E1ECE8</Color>
                    <Color x:Key="GitColor">#F34F29</Color>
                    <Color x:Key="GitTextColor">#FFFFFF</Color>
                    <Color x:Key="GitHoverColor">#B03C21</Color>
                    <Color x:Key="AcceptColor">#52796F</Color>
                    <Color x:Key="HighLightColor">#C68A32</Color>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PrimaryColor">#202428</Color>
                    <Color x:Key="BackgroundColor">#252A2F</Color>
                    <Color x:Key="SecondaryColor">#3A4148</Color>
                    <Color x:Key="TextBoxColor">#2D3339</Color>
                    <Color x:Key="TextColor">#E2E6E9</Color>
                    <Color x:Key="IconColor">#B8C0C7</Color>
                    <Color x:Key="AccentColor">#8FB7A8</Color>
                    <Color x:Key="SelectionColor">#35463F</Color>
                    <Color x:Key="GitColor">#F34F29</Color>
                    <Color x:Key="GitTextColor">#FFFFFF</Color>
                    <Color x:Key="GitHoverColor">#F2836B</Color>
                    <Color x:Key="AcceptColor">#8FB7A8</Color>
                    <Color x:Key="HighLightColor">#D6A254</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>